<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn from assets/icon/src. The inset is as little as keeps the page's
     corners inside the 66dp every launcher's mask leaves whole; Dicty's 16%
     drew it at half the circle, smaller than every icon around it. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@drawable/ic_launcher_background"/>
  <foreground>
      <inset
          android:drawable="@drawable/ic_launcher_foreground"
          android:inset="7%" />
  </foreground>
  <monochrome>
      <inset
          android:drawable="@drawable/ic_launcher_monochrome"
          android:inset="7%" />
  </monochrome>
</adaptive-icon>
