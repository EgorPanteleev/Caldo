<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn from assets/icon/src. Nothing behind the page: the Samsung
     calendar it is matched to is a page standing free in its icon's room,
     rings above the header, and One UI leaves a transparent ground
     transparent. Filling the ground with the sheet's colour made the
     page the launcher's squircle instead. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@android:color/transparent"/>
  <foreground android:drawable="@drawable/ic_launcher_foreground"/>
  <monochrome android:drawable="@drawable/ic_launcher_monochrome"/>
</adaptive-icon>
