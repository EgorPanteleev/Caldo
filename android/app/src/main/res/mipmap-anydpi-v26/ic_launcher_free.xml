<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn from assets/icon/src/caldo_free*. Nothing behind the page: the
     Samsung calendar it is matched to is a page standing free in its icon's
     room, rings above the header, and One UI leaves a transparent ground
     transparent. Only a Samsung is given this one (LauncherIcon); the Pixel
     launcher fills the ground black and its circle cuts the page's
     corners. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@android:color/transparent"/>
  <foreground android:drawable="@drawable/ic_launcher_free_foreground"/>
  <monochrome android:drawable="@drawable/ic_launcher_free_monochrome"/>
</adaptive-icon>
