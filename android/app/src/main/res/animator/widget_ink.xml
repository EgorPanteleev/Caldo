<?xml version="1.0" encoding="utf-8"?>
<!-- A card's ink: 30% of its colour while open (enabled), sinking to 9.45%
     once done, over the app's 240ms (`TaskCard.ink`, `doneInk`). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true">
        <objectAnimator
            android:duration="240"
            android:interpolator="@interpolator/widget_ease_out"
            android:propertyName="alpha"
            android:valueTo="0.30"
            android:valueType="floatType"/>
    </item>
    <item>
        <objectAnimator
            android:duration="240"
            android:interpolator="@interpolator/widget_ease_out"
            android:propertyName="alpha"
            android:valueTo="0.0945"
            android:valueType="floatType"/>
    </item>
</selector>
