<?xml version="1.0" encoding="utf-8"?>
<!-- A graphite panel rather than the app's true black. On a home screen the
     widget stands on a wallpaper, not on black, and a pure-black slab read
     as a hole in it; this is the app's own panel grey, lifted a step, and
     very slightly see-through so it belongs to what is behind it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#F21A1A1D"/>
    <corners android:radius="@dimen/widget_radius"/>
</shape>
