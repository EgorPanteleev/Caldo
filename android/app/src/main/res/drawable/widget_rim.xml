<?xml version="1.0" encoding="utf-8"?>
<!-- A card's rim (`TaskCard.rimOf`): 1.5 inside its edge, drawn white and
     coloured from code, at the strength set on the view. Its corners are
     the card's 14 less half the stroke, which is drawn centred on them.
     The clear fill is load-bearing: a shape with no fill comes out filled
     once a colour filter is put on it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#00000000"/>
    <stroke android:width="1.5dp" android:color="#FFFFFFFF"/>
    <corners android:radius="13.25dp"/>
</shape>
