<?xml version="1.0" encoding="utf-8"?>
<!-- The widget: Schedule in small — its title and an add button, then the
     runs of days, fading out at the foot as the list runs on under it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp">

        <TextView
            android:id="@+id/widget_screen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="#FFE9E9EB"
            android:textSize="21sp"
            android:textStyle="bold"/>

        <!-- The quick-add button: a plus on the field's grey. -->
        <ImageView
            android:id="@+id/widget_add"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_add_ground"
            android:contentDescription="@string/widget_new_task"
            android:padding="9dp"
            android:src="@drawable/widget_add"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Not a list: a list rebinds a card where it now stands, so a
             ticked task jumped to the end of its day. A plain layout is
             redrawn in place, keeping each run and card under its key, and
             animates what moved. It does not scroll; what does not fit runs
             on under the fade at the foot. -->
        <LinearLayout
            android:id="@+id/widget_runs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical"/>

        <LinearLayout
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="14dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:alpha="0.5"
                android:src="@drawable/widget_tick_violet_on"/>

            <TextView
                android:id="@+id/widget_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/widget_nothing"
                android:textColor="#FF6A6A70"
                android:textSize="13.5sp"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_foot"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_gravity="bottom"
            android:src="@drawable/widget_foot"
            android:scaleType="fitXY"/>
    </FrameLayout>
</LinearLayout>
