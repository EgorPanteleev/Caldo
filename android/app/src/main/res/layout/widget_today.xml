<?xml version="1.0" encoding="utf-8"?>
<!-- The widget: a calendar's header — the day's number large, its weekday
     and month beside it — then the runs of days, fading out at the foot as
     the list runs on under it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="14dp"
    android:paddingEnd="12dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="2dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/widget_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:textColor="#FFE9E9EB"
            android:textSize="34sp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_weekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="#FFE9E9EB"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#FF9B9BA1"
                android:textSize="12.5sp"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_add"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_add_ground"
            android:contentDescription="@string/widget_new_task"
            android:padding="8dp"
            android:src="@drawable/widget_add"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/widget_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:fadingEdgeLength="28dp"
            android:paddingBottom="12dp"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none"/>

        <LinearLayout
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="14dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:alpha="0.5"
                android:src="@drawable/widget_tick_violet_on"/>

            <TextView
                android:id="@+id/widget_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/widget_nothing"
                android:textColor="#FF6A6A70"
                android:textSize="13.5sp"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
