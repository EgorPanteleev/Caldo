<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Reminders are alarms: they have to survive a reboot, and they have to
         land at the minute the task is due rather than whenever the system
         next feels like waking up. USE_EXACT_ALARM is the calendar-app form of
         that, granted on install; SCHEDULE_EXACT_ALARM is the older one, which
         the user grants, and is here for the Android versions that only know
         about it. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <!-- A reminder takes the whole screen while the phone is locked, as an
         alarm does. Granted on install to an app that does not come from the
         Play Store; Settings asks for it again where it has been taken away.
         The activity is let over the lock screen only while a reminder is
         up (MainActivity.overLock), never by an attribute here, which would
         have the whole app show without the phone being unlocked. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <!-- The one thing the app goes online for: asking GitHub whether a newer
         release than the installed one exists, and downloading its APK when
         the banner that says so is tapped. Everything else stays on the
         device. Caldo installs it itself (SelfUpdate), which an app may only
         do if it says so here — and the user still has to allow Caldo to
         install apps, once, in settings. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Events from the phone's own calendars are shown beside the tasks,
         read-only, once Settings has been asked to and the user has said
         yes. Nothing is ever written to them. -->
    <uses-permission android:name="android.permission.READ_CALENDAR"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Lets an update Caldo installed itself go over it without asking. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION"/>

    <application
        android:label="Caldo"
        android:name=".CaldoApplication"
        android:icon="@mipmap/ic_launcher">
        <!-- No taskAffinity="" here, though Flutter's template has one. An
             empty affinity matches no task, so the installer's "Open" after
             an update started a second Caldo beside the one the update was
             tapped in, and the recent apps showed the app twice. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
        </activity>
        <!-- The launcher's two ways in, each with its own icon, one on at a
             time (LauncherIcon): the page standing free on a Samsung, whose
             launcher keeps a transparent ground, and the page filling the
             shape everywhere else, where the ground would be filled black. -->
        <activity-alias
            android:name=".LauncherFree"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_free"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherFilled"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <!-- Shows a reminder when its alarm goes off, and puts the alarms
             back after a reboot or an update — a scheduled notification is
             held by the system, and the system forgets them both times. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false"/>
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Takes a reminder's Done and Snooze. The plugin does not declare
             it for us: without this line the buttons are drawn and every
             tap on them is dropped without a word. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"
            android:exported="false"/>

        <!-- The home-screen widget, and the service that hands it its rows.
             The receiver also takes the widget's taps and its midnight
             redraw, so it is exported only as far as the launcher needs. -->
        <!-- Says an update from inside the app is in (SelfUpdate): Android
             will not let the app open itself again after replacing it. -->
        <receiver
            android:name=".UpdateDone"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>

        <receiver
            android:name=".TodayWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info"/>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- The calendar provider the events are read from. -->
        <provider android:authorities="com.android.calendar"/>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
